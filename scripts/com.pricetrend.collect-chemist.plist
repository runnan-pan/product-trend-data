<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pricetrend.collect-chemist</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/runnan.pan/Documents/Personal Project/product-trend-data/scripts/collect_loop.sh</string>
    <string>/Users/runnan.pan/Documents/Personal Project/Chemist Warehouse Trend</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- The script itself loops forever with its own backoff/sleep logic.
       RunAtLoad starts it as soon as this agent is loaded; KeepAlive
       restarts it if the process ever exits (crash, forced kill, etc). -->
  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/runnan.pan/Documents/Personal Project/product-trend-data/scripts/launchd.collect-chemist.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/runnan.pan/Documents/Personal Project/product-trend-data/scripts/launchd.collect-chemist.err.log</string>
</dict>
</plist>
